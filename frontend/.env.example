# Modelo do .env.local do front. Copie para .env.local se precisar mudar algo:
# sem nenhum valor, o front encontra sozinho a API local (consulta
# /api/health em http://localhost:4444).

# Endereço da API, se não for o local padrão.
VITE_API_ORIGIN=

# Push (Firebase Cloud Messaging, app web). Vazio = push desligado.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_VAPID_KEY=

# Monitoramento de erros (Sentry). Vazio = nada é enviado.
VITE_SENTRY_DSN=
VITE_APP_VERSION=
