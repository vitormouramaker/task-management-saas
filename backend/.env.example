# Modelo do .env. Copie para .env e ajuste. O .env nunca vai para o git.
# Os valores abaixo já funcionam localmente (Postgres na 5432, front na 5173).

PORT=4444
NODE_ENV=development

DB_USER=postgres
DB_HOST=localhost
DB_NAME=pauta
DB_PASSWORD=postgres
DB_PORT=5432

# Endereço do front (links dos e-mails e CORS). Outras origens: CORS_ORIGINS
# separadas por vírgula.
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=

# Autenticação (JWT). Mínimo de 32 caracteres cada. Gere com:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Os valores abaixo servem SÓ para rodar localmente.
JWT_SECRET=troque-este-segredo-local-de-desenvolvimento-0001
JWT_REFRESH_SECRET=troque-este-segredo-local-de-desenvolvimento-0002

# E-mails que viram super-administradores (painel /admin) ao subir a API.
# O seed de demonstração já marca admin@demo.pauta.test.
PLATFORM_ADMIN_EMAILS=
# Opcional: restringe o painel de super-admin a estes IPs.
PLATFORM_ADMIN_ALLOWED_IPS=

# SMTP opcional. Vazio = os e-mails não saem da máquina: destinatário, assunto
# e links (confirmar e-mail, convite, recuperar senha) aparecem no console.
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SUPPORT_EMAIL=contato@example.com
ENTERPRISE_REQUESTS_EMAIL=contato@example.com

# Arquivos (anexos, avatares). Sem conta na Bunny, use o armazenamento local de
# desenvolvimento: uma pasta do disco servida pela própria API na porta 4631.
LOCAL_STORAGE_DIR=./storage-local
LOCAL_STORAGE_PORT=4631
BUNNY_STORAGE_ZONE=pauta
BUNNY_ACCESS_KEY=chave-local-de-desenvolvimento
BUNNY_STORAGE_API_ORIGIN=http://localhost:4631
BUNNY_PULL_ZONE=localhost:4631
BUNNY_PULL_ZONE_PROTOCOL=http
# Com a Bunny de verdade: apague LOCAL_STORAGE_*, use a chave da storage zone,
# BUNNY_STORAGE_API_ORIGIN=https://br.storage.bunnycdn.com, a pull zone
# (ex.: minha-zona.b-cdn.net) com BUNNY_PULL_ZONE_PROTOCOL=https e, se quiser
# links assinados, a chave de Token Authentication:
BUNNY_TOKEN_AUTH_KEY=
# Relatório de custos (painel de super-admin): chave da conta Bunny.
BUNNY_API_KEY=

# Stripe (assinaturas). Vazio = cobrança desligada; tudo o mais funciona.
# Use chaves de TESTE (sk_test_...). Os preços vêm do seu painel da Stripe.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ESSENCIAL_MONTHLY=
STRIPE_PRICE_ESSENCIAL_YEARLY=
STRIPE_PRICE_ESSENCIAL_SEAT_MONTHLY=
STRIPE_PRICE_ESSENCIAL_SEAT_YEARLY=
STRIPE_PRICE_PROFISSIONAL_MONTHLY=
STRIPE_PRICE_PROFISSIONAL_YEARLY=
STRIPE_PRICE_PROFISSIONAL_SEAT_MONTHLY=
STRIPE_PRICE_PROFISSIONAL_SEAT_YEARLY=
STRIPE_PRICE_EMPRESARIAL_MONTHLY=
STRIPE_PRICE_EMPRESARIAL_YEARLY=
STRIPE_PRICE_EMPRESARIAL_SEAT_MONTHLY=
STRIPE_PRICE_EMPRESARIAL_SEAT_YEARLY=
STRIPE_PRICE_STORAGE_100GB_MONTHLY=
STRIPE_PRICE_STORAGE_100GB_YEARLY=

# Push (Firebase Cloud Messaging). Vazio = push desligado; os avisos continuam
# no sininho e em tempo real. Cole o JSON da conta de serviço numa linha só.
FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_PROJECT_ID=

# NFS-e automática pela API da prefeitura (layout nacional). Vazio = a emissão
# fica manual (fila no painel de super-admin).
NFSE_AMBIENTE=homologacao
NFSE_URL_BASE=
NFSE_CODIGO_MUNICIPIO=3550308
NFSE_CNPJ=
NFSE_INSCRICAO_MUNICIPAL=
NFSE_RAZAO_SOCIAL=
NFSE_CODIGO_TRIB_NACIONAL=
NFSE_CERT_PFX_BASE64=
NFSE_CERT_SENHA=

# Consulta de CNPJ no cadastro de conta empresarial (BrasilAPI, pública).
BRASIL_API_CNPJ_URL=https://brasilapi.com.br/api/cnpj/v1

# Monitoramento de erros (Sentry). Vazio = nada é enviado.
SENTRY_DSN=
# Diagnóstico completo em /api/health/detalhado (cabeçalho x-health-token).
HEALTH_TOKEN=

# Ambiente fechado por senha (homologação). Vazio = desligado.
PORTAO_SENHA=
